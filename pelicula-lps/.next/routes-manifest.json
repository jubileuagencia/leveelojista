{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/curso/[courseSlug]",
      "regex": "^/curso/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcourseSlug": "nxtPcourseSlug"
      },
      "namedRegex": "^/curso/(?<nxtPcourseSlug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/curso/[courseSlug]/[lessonSlug]",
      "regex": "^/curso/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcourseSlug": "nxtPcourseSlug",
        "nxtPlessonSlug": "nxtPlessonSlug"
      },
      "namedRegex": "^/curso/(?<nxtPcourseSlug>[^/]+?)/(?<nxtPlessonSlug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/auth/callback",
      "regex": "^/auth/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/callback(?:/)?$"
    },
    {
      "page": "/camarim",
      "regex": "^/camarim(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/camarim(?:/)?$"
    },
    {
      "page": "/catalogo",
      "regex": "^/catalogo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/catalogo(?:/)?$"
    },
    {
      "page": "/checkout",
      "regex": "^/checkout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout(?:/)?$"
    },
    {
      "page": "/checkout/sucesso",
      "regex": "^/checkout/sucesso(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout/sucesso(?:/)?$"
    },
    {
      "page": "/decifrando",
      "regex": "^/decifrando(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/decifrando(?:/)?$"
    },
    {
      "page": "/decifrando-costar",
      "regex": "^/decifrando\\-costar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/decifrando\\-costar(?:/)?$"
    },
    {
      "page": "/forgot-password",
      "regex": "^/forgot\\-password(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/forgot\\-password(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/mapa-astral",
      "regex": "^/mapa\\-astral(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mapa\\-astral(?:/)?$"
    },
    {
      "page": "/minha-conta",
      "regex": "^/minha\\-conta(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/minha\\-conta(?:/)?$"
    },
    {
      "page": "/reset-password",
      "regex": "^/reset\\-password(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reset\\-password(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}