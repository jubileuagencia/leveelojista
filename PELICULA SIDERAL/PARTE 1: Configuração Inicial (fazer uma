  ├──────────┼─────────────────────────┼───────┼────────────────────┤
  │ 4        │ câncer/cancer           │ ♋    │ interp_cancer      │
  ├──────────┼─────────────────────────┼───────┼────────────────────┤
  │ 5        │ leão/leao               │ ♌    │ interp_leao        │
  ├──────────┼─────────────────────────┼───────┼────────────────────┤
  │ 6        │ virgem                  │ ♍    │ interp_virgem      │
  ├──────────┼─────────────────────────┼───────┼────────────────────┤
  │ 7        │ libra                   │ ♎    │ interp_libra       │
  ├──────────┼─────────────────────────┼───────┼────────────────────┤
  │ 8        │ escorpião/escorpiao     │ ♏    │ interp_escorpiao   │
  ├──────────┼─────────────────────────┼───────┼────────────────────┤
  │ 9        │ sagitário/sagitario     │ ♐    │ interp_sagitario   │
  ├──────────┼─────────────────────────┼───────┼────────────────────┤
  │ 10       │ capricórnio/capricornio │ ♑    │ interp_capricornio │
  ├──────────┼─────────────────────────┼───────┼────────────────────┤
